{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Playwright's fixture callback is named `use`, which the rule takes for a React hook; e2e has no React.
      "files": ["e2e/**"],
      "rules": { "react/rules-of-hooks": "off" }
    },
    // Layers: entities <- services <- components/lib <- features <- layout <- pages <- router. Each folder may import
    // only from the layers before it, so a dependency always points inward. One exception: router/route.ts (parsing
    // the hash and building links) is a leaf helper every layer may import; RouterView and lazyPage are not.
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["@/services", "@/services/**", "@/features/**", "@/components/**", "@/layout/**", "@/pages/**", "@/router/**", "@/lib/**"],
          "message": "entities hold types and pure rules only; they import nothing from the app."
        }] }]
      }
    },
    {
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["@/features/**", "@/components/**", "@/layout/**", "@/pages/**", "@/router/**"],
          "message": "services sit under the UI: move what they need into services, entities or lib."
        }] }]
      }
    },
    {
      "files": ["src/components/**", "src/lib/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["@/features/**", "@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"],
          "message": "shared code must not know about features, layout or pages: pass what it needs in as props."
        }] }]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"],
          "message": "features sit under layout and pages; only pages put them on screen."
        }] }]
      }
    },
    {
      "files": ["src/layout/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{
          "group": ["@/pages/**", "@/router/RouterView", "@/router/lazyPage"],
          "message": "layout sits under pages: a page puts the shell around itself."
        }] }]
      }
    },
    // .tsx files draw the UI: they get data from hooks, never from the api object itself. A later override replaces
    // an earlier one's options for the same rule, so each repeats its folder's layer pattern. Tests stub endpoints
    // with vi.spyOn(api, …), so they may import it.
    {"files": ["src/features/**/*.tsx"], "rules": {"no-restricted-imports": ["error", {"paths": [{"name": "@/services/api", "importNames": ["api"], "message": "UI reads and writes data through a hook from @/services/queries; URL builders are named exports."}], "patterns": [{"group": ["@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "features sit under layout and pages; only pages put them on screen."}]}]}},
    {"files": ["src/components/**/*.tsx"], "rules": {"no-restricted-imports": ["error", {"paths": [{"name": "@/services/api", "importNames": ["api"], "message": "UI reads and writes data through a hook from @/services/queries; URL builders are named exports."}], "patterns": [{"group": ["@/features/**", "@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "shared code must not know about features, layout or pages: pass what it needs in as props."}]}]}},
    {"files": ["src/layout/**/*.tsx"], "rules": {"no-restricted-imports": ["error", {"paths": [{"name": "@/services/api", "importNames": ["api"], "message": "UI reads and writes data through a hook from @/services/queries; URL builders are named exports."}], "patterns": [{"group": ["@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "layout sits under pages: a page puts the shell around itself."}]}]}},
    {"files": ["src/pages/**/*.tsx"], "rules": {"no-restricted-imports": ["error", {"paths": [{"name": "@/services/api", "importNames": ["api"], "message": "UI reads and writes data through a hook from @/services/queries; URL builders are named exports."}]}]}},
    {"files": ["src/features/**/*.test.tsx"], "rules": {"no-restricted-imports": ["error", {"patterns": [{"group": ["@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "features sit under layout and pages; only pages put them on screen."}]}]}},
    {"files": ["src/components/**/*.test.tsx"], "rules": {"no-restricted-imports": ["error", {"patterns": [{"group": ["@/features/**", "@/layout/**", "@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "shared code must not know about features, layout or pages: pass what it needs in as props."}]}]}},
    {"files": ["src/layout/**/*.test.tsx"], "rules": {"no-restricted-imports": ["error", {"patterns": [{"group": ["@/pages/**", "@/router/RouterView", "@/router/lazyPage"], "message": "layout sits under pages: a page puts the shell around itself."}]}]}},
    {"files": ["src/pages/**/*.test.tsx"], "rules": {"no-restricted-imports": "off"}}
  ]
}
