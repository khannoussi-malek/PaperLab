#!/usr/bin/env bash
# Writes the Homebrew casks from the GitHub releases: Casks/paperlab@<version>.rb for every published release with
# both macOS DMGs, and Casks/paperlab.rb for the newest. The Homebrew workflow runs it when a release is published;
# it needs gh logged in (GH_TOKEN). Usage: scripts/homebrew-casks [out-dir]
set -euo pipefail

repo=${GITHUB_REPOSITORY:-khannoussi-malek/PaperLab}
out=${1:-Casks}

# cask <token> <version> <arm64 sha256> <x64 sha256>
cask() {
  cat <<EOF
# Generated by scripts/homebrew-casks from the v$2 release. Don't edit by hand.
cask "$1" do
  arch arm: "arm64", intel: "x64"

  version "$2"
  sha256 arm:   "$3",
         intel: "$4"

  url "https://github.com/$repo/releases/download/v#{version}/PaperLab-#{version}-#{arch}.dmg"
  name "PaperLab"
  desc "Local-first research reader for your papers"
  homepage "https://github.com/$repo"

  depends_on :macos

  app "PaperLab.app"

  # PaperLab is ad-hoc signed, not notarized: clear the quarantine flag so macOS opens it without Open Anyway.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/PaperLab.app"]
  end

  caveats "PaperLab runs on Docker: install Docker Desktop (brew install --cask docker-desktop) and open it once."
end
EOF
}

# One line per published release, newest first: tag, arm64 DMG digest, x64 DMG digest (empty when missing).
releases=$(gh api --paginate "repos/$repo/releases" -q '.[] | select(.draft or .prerelease | not)
  | [.tag_name,
     ([.assets[] | select(.name | endswith("-arm64.dmg")) | .digest][0] // ""),
     ([.assets[] | select(.name | endswith("-x64.dmg")) | .digest][0] // "")] | @tsv')

mkdir -p "$out"
# Rebuilt from scratch, so a deleted release loses its cask.
rm -f "$out"/paperlab*.rb
latest=
while IFS=$'\t' read -r tag arm intel; do
  [[ $arm == sha256:* && $intel == sha256:* ]] || { echo "skipping $tag: no digest for both macOS DMGs" >&2; continue; }
  version=${tag#v}
  cask "paperlab@$version" "$version" "${arm#sha256:}" "${intel#sha256:}" > "$out/paperlab@$version.rb"
  # ponytail: newest = first in the list (GitHub sorts by creation date); fine while releases are tagged in order.
  if [[ -z $latest ]]; then
    latest=$version
    cask paperlab "$version" "${arm#sha256:}" "${intel#sha256:}" > "$out/paperlab.rb"
  fi
done <<< "$releases"

[[ -n $latest ]] || { echo "no release has both macOS DMGs" >&2; exit 1; }
echo "wrote casks for $(ls "$out" | grep -c '^paperlab@') releases; paperlab is $latest"
