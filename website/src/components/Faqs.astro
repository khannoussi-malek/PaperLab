---
// Questions and answers as native <details>; the same list feeds the page's FAQPage data.
interface Props {
  faqs: { q: string; a: string }[]
}
const { faqs } = Astro.props
---

<section aria-labelledby="faq-heading" class="faqs">
  <h2 id="faq-heading">Questions people ask</h2>
  {
    faqs.map(({ q, a }) => (
      <details>
        <summary>
          <h3>{q}</h3>
        </summary>
        <p class="muted">{a}</p>
      </details>
    ))
  }
</section>

<style>
  .faqs {
    margin-top: 2.5rem;
  }
  details {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }
  summary {
    cursor: pointer;
  }
  summary h3 {
    display: inline;
    font-size: 1.2rem;
  }
  details p {
    margin: 0.6rem 0 0.25rem;
  }
</style>
