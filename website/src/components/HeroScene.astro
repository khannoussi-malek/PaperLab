---
// The hero picture: the drawn reading desk, and on browsers with WebGL and motion allowed, the teaser's 3D scene across
// the whole hero section. The desk keeps its place in the layout, so nothing moves when the 3D takes over; the parent
// section must be `position: relative`.
import ReadingDesk from './ReadingDesk.astro'
---

<div class="hero-scene" data-hero-scene>
  <ReadingDesk />
  <canvas class="constellation" aria-hidden="true"></canvas>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-hero-scene]')
  const canvas = box?.querySelector('canvas')
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches
  if (box && canvas && !still) {
    // Three.js loads after the page has drawn, so the words and the download button come first.
    import('../lib/constellation')
      .then(({ startConstellation }) => startConstellation(canvas, box))
      .then(() => box.classList.add('live'))
      .catch((error) => console.warn('PaperLab: 3D hero unavailable, showing the drawn one.', error))
  }
</script>

<style>
  /* The canvas fills the whole hero section (the nearest positioned ancestor), behind the words, so the pages fly
     through all of it; the story stays on this slot. */
  .hero-scene {
    position: static;
  }
  .constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }
  .live .constellation {
    opacity: 1;
  }
  /* Behind the words the pages still fly, but faint, so white text on a white page stays readable. */
  @media (min-width: 881px) {
    .constellation {
      mask-image: linear-gradient(to right, rgb(0 0 0 / 0.3) 0 42%, #000 56%);
    }
  }
  @media (max-width: 880px) {
    .constellation {
      mask-image: linear-gradient(rgb(0 0 0 / 0.3) 0 42%, #000 58%);
    }
  }
  .live :global(.desk) {
    visibility: hidden;
  }
</style>
