POSTGRES_PASSWORD=paperlab
DATABASE_URL=postgresql+asyncpg://paperlab:paperlab@db:5432/paperlab
REDIS_URL=redis://redis:6379
PDF_DIR=/data/pdfs
OLLAMA_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# LLM_PROVIDER, LLM_MODEL, OLLAMA_URL and ANTHROPIC_API_KEY only create the first model connection, while there are none.
# After that, add connections and keys, and pick models, in Settings.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MAX_TOKENS=64000
# OPENALEX_MAILTO and SEMANTIC_SCHOLAR_API_KEY only fill in Settings → Paper sources once, on first start: your
# contact email, with OpenAlex ticked, and a Semantic Scholar key. After that, tick sources
# and add keys in Settings.
OPENALEX_MAILTO=
# SEMANTIC_SCHOLAR_API_KEY=
