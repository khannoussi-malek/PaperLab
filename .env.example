POSTGRES_PASSWORD=paperlab
DATABASE_URL=postgresql+asyncpg://paperlab:paperlab@db:5432/paperlab
REDIS_URL=redis://redis:6379
PDF_DIR=/data/pdfs
OLLAMA_URL=http://host.docker.internal:11434
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# LLM_PROVIDER, LLM_MODEL, OLLAMA_URL and ANTHROPIC_API_KEY only create the first model connection, while there are none.
# After that, add connections and keys, and pick models, in Settings.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MAX_TOKENS=64000
# Off by default: enrichment (paper metadata from OpenAlex) only runs when this is set. The value is sent, as
# a "mailto" query param, to api.openalex.org on every request.
OPENALEX_MAILTO=
# Optional: a Semantic Scholar API key for Similar papers, arXiv lookups and free PDF links in Find papers. Without
# one, Semantic Scholar's shared pool sometimes answers "busy".
# SEMANTIC_SCHOLAR_API_KEY=
